rules_version = '2';

// Regras da fase de testes: qualquer usuário autenticado lê e escreve os
// dados da clínica. Antes de cadastrar pacientes reais, restringir por papel
// (role) e por clínica — hoje qualquer conta criada pelo app vê tudo.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Perfis: cada pessoa só cria/edita o próprio, sempre como 'convidado'
    // e sem poder alterar o papel. Papéis maiores são definidos pelo console.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'convidado';
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Notificações são criadas pelas Cloud Functions; o dono só lê,
    // marca como lida e apaga.
    match /users/{uid}/notifications/{notificationId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // Tokens de push (FCM) dos aparelhos do usuário
    match /users/{uid}/devices/{token} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Consulta de grupo (todos os procedimentos) usada em Oportunidades
    match /{path=**}/procedures/{procedureId} {
      allow read: if signedIn();
    }

    match /{collection}/{document=**} {
      allow read, write: if signedIn() && collection != 'users';
    }
  }
}
