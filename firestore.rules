rules_version = '2';

// Regras iniciais: qualquer usuário autenticado da clínica lê e escreve tudo.
// Antes de ir para produção com dados reais, restringir por papel (role)
// e por clínica.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
